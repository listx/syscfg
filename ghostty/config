macos-option-as-alt = left

cursor-style-blink = false

font-family = "CommitMono"
font-size = 17
font-feature = cv06

window-width = 163
window-height = 102
window-padding-x = 4,0
window-padding-y = 0

gtk-titlebar = false

background = #343c48
foreground = #e5e7ea
cursor-color = #ffffff
cursor-text = #000000
selection-background = #fffacd
selection-foreground = #000000
palette = 0=#22222f
palette = 1=#e49f9f
palette = 2=#91e380
palette = 3=#eae47c
palette = 4=#7cacd3
palette = 5=#df9494
palette = 6=#8cdbd8
palette = 7=#e5e7ea
palette = 8=#99999f
palette = 9=#e5bfbf
palette = 10=#afe0a1
palette = 11=#f2fb9e
palette = 12=#95add1
palette = 13=#f2b0b0
palette = 14=#b4f0f0
palette = 15=#ffffff

confirm-close-surface = false

keybind = ctrl+shift+a=unbind
keybind = ctrl+shift+c=unbind
keybind = ctrl+shift+e=unbind
keybind = ctrl+shift+f=unbind
keybind = ctrl+shift+i=unbind
keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+p=unbind
keybind = ctrl+shift+q=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+v=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+,=unbind
keybind = ctrl+shift+enter=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = ctrl+shift+page_up=unbind
keybind = ctrl+shift+page_down=unbind
keybind = ctrl+alt+shift+j=unbind
keybind = ctrl+==unbind
keybind = ctrl++=unbind
keybind = ctrl+-=unbind
keybind = ctrl+0=unbind
keybind = ctrl+,=unbind
keybind = super+a=select_all
keybind = super+c=copy_to_clipboard:mixed
keybind = super+e=new_split:down
keybind = super+f=start_search
keybind = super+i=inspector:toggle
keybind = super+j=write_screen_file:paste,plain
keybind = super+n=new_window
keybind = super+o=new_split:right
keybind = super+p=toggle_command_palette
keybind = super+q=quit
keybind = super+t=new_tab
keybind = super+v=paste_from_clipboard
keybind = super+w=close_tab:this
keybind = super+,=reload_config
keybind = super+shift+enter=toggle_split_zoom
keybind = super+shift+tab=previous_tab
keybind = super+shift+arrow_left=previous_tab
keybind = super+shift+arrow_right=next_tab
keybind = super+shift+page_up=jump_to_prompt:-1
keybind = super+shift+page_down=jump_to_prompt:1
keybind = super+alt+shift+j=write_screen_file:open,plain
keybind = super+==increase_font_size:1
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size
