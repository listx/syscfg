#!/usr/bin/env zsh

# SSH to known machines.

s()
{
	if (( $#@ == 0 )); then
		echo >&2 "Usage: <HOST>"
		return 1
	fi

	local user
	local host="${1}"
	local -a keep_awake

	case "${host}" in
	w0) user="ingra" ;;
	*)  user="l" ;;
	esac

	if (( $+commands[caffeinate] )); then
		keep_awake=(caffeinate -i)
	fi

	tmux rename-window "ssh->${user}@${host}"

	case "${host}" in
	w0)
		"${keep_awake[@]}" ssh -t "${user}@${host}" \"wsl.exe -d NixOS\"
		;;
	*)
		"${keep_awake[@]}" ssh -t "${user}@${host}"
		;;
	esac

	tmux set -w automatic-rename on
}
